{
    "name": "My Pytorch Dev",
    "build": { "dockerfile": "Dockerfile", "context": ".." },
    "runArgs": ["--gpus", "all"],
    "settings": { "terminal.integrated.shell.linux": "/bin/bash" },
    "remoteUser": "root",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace"
}
